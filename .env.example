# Copiar a .env y completar con los datos del proyecto de Supabase
# (Supabase → Project Settings → API).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxx

# Opcional (v0.4): clave de Anthropic para que el asistente entienda pedidos en lenguaje natural.
# Sin esta clave el asistente usa reglas simples y sigue funcionando.
# Solo la usa el servidor: nunca llega al navegador.
NUXT_ANTHROPIC_API_KEY=
