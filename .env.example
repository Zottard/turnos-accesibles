# Copiar a .env y completar con los datos del proyecto de Supabase
# (Supabase → Project Settings → API).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxx

# Opcional (v0.4): clave de Anthropic para que el asistente entienda pedidos en lenguaje natural.
# Sin esta clave el asistente usa reglas simples y sigue funcionando.
# Solo la usa el servidor: nunca llega al navegador.
NUXT_ANTHROPIC_API_KEY=

# Opcional (v0.5): avisos por correo (comprobante, cancelación, cambio y recordatorio) e
# invitaciones a acompañantes, con Resend. Sin estas claves los avisos quedan solo en la app.
# Solo las usa el servidor: nunca llegan al navegador.
# NUXT_SUPABASE_SECRET_KEY: clave secreta de Supabase (Project Settings → API Keys → secret).
#   La usa únicamente /api/avisos/enviar para leer los avisos pendientes de todas las personas.
# NUXT_CRON_SECRET: protege /api/avisos/enviar. En Vercel, poné el mismo valor en CRON_SECRET
#   (es la que manda el cron de vercel.json).
# NUXT_CORREO_REMITENTE: por ejemplo "Turnos Accesibles <avisos@tu-dominio.com>" (dominio verificado en Resend).
NUXT_SUPABASE_SECRET_KEY=
NUXT_CRON_SECRET=
NUXT_RESEND_API_KEY=
NUXT_CORREO_REMITENTE=
